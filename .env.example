# ---- Backend selection (all optional; defaults are free/offline) ----
# auto (default) | typesafe_jev | openjev_local | laya_local | heuristic
JEV_BACKEND_PROVIDER=auto

# ---- Hosted TypeSafe Jev (native or gateway) ----
# TYPESAFE_JEV_API_KEY=...
# TYPESAFE_JEV_BASE_URL=https://api.typesafe.ai/v1
# TYPESAFE_JEV_MODEL=typesafe/jev
# Force the native /choice /score /noul endpoints instead of the chat proxy:
# TYPESAFE_JEV_NATIVE=1
# Or use the free Vercel AI Gateway tier:
# VERCEL_AI_GATEWAY_KEY=...

# ---- Local OpenJev (vLLM, Docker) ----
# docker run --gpus all -p 8000:8000 razorback16/openjev
OPENJEV_BASE_URL=http://localhost:8000/v1
# OPENJEV_API_KEY=...
# OPENJEV_MODEL=openjev

# ---- LayA local (ModernBERT head) ----
# python -m laya.serve --port 8000
# LAYA_BASE_URL=http://localhost:8000/v1
# LAYA_MODEL=layalike

# ---- System-2 LLM (planner / red-team / researcher) ----
# Ollama default: http://localhost:11434/v1
# vLLM: http://localhost:8000/v1
# LM Studio: http://localhost:1234/v1
JEV_LLM_BASE_URL=http://localhost:11434/v1
JEV_LLM_MODEL=qwen2.5:7b-instruct
# JEV_LLM_API_KEY=...
# JEV_LLM_DISABLED=false

# ---- Gatekeeper policy (auto-tuned by verified outcomes) ----
JEV_GATE_EXECUTE=0.85
JEV_GATE_ESCALATE=0.6

# ---- Persistence / limits ----
# JEV_MEMORY_PATH=./.jev-skill-memory.json
JEV_CONCURRENCY=8
JEV_LOG_LEVEL=warn

# ---- Optional data sources ----
# GITHUB_TOKEN=...
# BRAVE_API_KEY=...
# TWITTER_BEARER_TOKEN=...
